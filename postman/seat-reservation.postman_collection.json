                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "const b = pm.response.json();",
                  "pm.test(\"available + held + confirmed == total_seats\", function () {",
                  "  pm.expect(b.counts.available + b.counts.held + b.counts.confirmed).to.eql(b.total_seats);",
                  "});"
                ]
              }
            }
          ]
        }
