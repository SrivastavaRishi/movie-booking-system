{
  "info": {
    "name": "Seat Reservation",
    "description": "Seat Reservation at Scale API. Select the Local or Staging environment first: it sets baseUrl, and tokens, show id and reservation id are saved into that environment automatically, so each environment keeps its own. Run the folders top to bottom.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "adminEmail",
      "value": "admin@seatbooking.local"
    },
    {
      "key": "adminPassword",
      "value": "Admin@12345"
    },
    {
      "key": "userPassword",
      "value": "password123"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Fresh emails per run so Register always succeeds",
          "if (!pm.environment.get('userEmail')) {",
          "  const run = Date.now();",
          "  pm.environment.set('userEmail', 'alice-' + run + '@example.com');",
          "  pm.environment.set('user2Email', 'bob-' + run + '@example.com');",
          "}",
          "if (!pm.environment.get('idempotencyKey')) {",
          "  pm.environment.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/live",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "live"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/ready",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "ready"
              ]
            },
            "description": "200 when the DB is reachable, 503 when it is not (fails closed)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
